<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WinTrim.Avalonia.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
        xmlns:ctrl="using:WinTrim.Avalonia.Controls"
        mc:Ignorable="d" 
        d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="WinTrim.Avalonia.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="WinTrim - Disk Analyzer"
        Icon="/Assets/wintrim.png"
        Width="1280" Height="800"
        MinWidth="900" MinHeight="600"
        Background="{DynamicResource BackgroundBrush}"
        FontSize="{DynamicResource BaseFontSize}"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Resources>
        <!-- File/Folder Context Menu -->
        <MenuFlyout x:Key="FileItemContextMenu">
            <MenuItem Header="📂 Open File Location" Click="FileItemOpenFolder_Click"/>
            <MenuItem Header="📋 Copy Path" Click="FileItemCopyPath_Click"/>
            <Separator/>
            <MenuItem Header="� Add to Collector" Click="FileItemAddToCollector_Click"/>
        </MenuFlyout>
        
        <!-- Game Context Menu -->
        <MenuFlyout x:Key="GameContextMenu">
            <MenuItem Header="📂 Open Game Folder" Click="GameOpenFolder_Click"/>
            <MenuItem Header="📋 Copy Path" Click="GameCopyPath_Click"/>
        </MenuFlyout>
        
        <!-- Developer Tool Context Menu -->
        <MenuFlyout x:Key="DevToolContextMenu">
            <MenuItem Header="📂 Open Location" Click="DevToolOpenFolder_Click"/>
            <MenuItem Header="📋 Copy Path" Click="DevToolCopyPath_Click"/>
        </MenuFlyout>
        
        <!-- Treemap Context Menu -->
        <MenuFlyout x:Key="TreemapContextMenu">
            <MenuItem Header="📋 Copy Path" Click="TreemapCopyPath_Click"/>
            <MenuItem Header="📂 Open Folder Location" Click="TreemapOpenFolder_Click"/>
            <Separator/>
            <MenuItem Header="📥 Add to Collector" Click="TreemapAddToCollector_Click"/>
            <Separator/>
            <MenuItem Header="⬆️ Navigate Back (Up)" Click="TreemapNavigateBack_Click"/>
        </MenuFlyout>
        
        <!-- Cleanup File Context Menu -->
        <MenuFlyout x:Key="CleanupFileContextMenu">
            <MenuItem Header="📂 Open File Location" Click="CleanupFileOpenFolder_Click"/>
            <MenuItem Header="📋 Copy Path" Click="CleanupFileCopyPath_Click"/>
        </MenuFlyout>
        
        <!-- Cleanup Suggestion Context Menu -->
        <MenuFlyout x:Key="CleanupSuggestionContextMenu">
            <MenuItem Header="📂 Open Location" Click="CleanupSuggestionOpenFolder_Click"/>
            <MenuItem Header="📋 Copy Path" Click="CleanupSuggestionCopyPath_Click"/>
        </MenuFlyout>
        
        <!-- Duplicate File Context Menu -->
        <MenuFlyout x:Key="DuplicateContextMenu">
            <MenuItem Header="📂 Open File Location" Click="DuplicateOpenFolder_Click"/>
            <MenuItem Header="📋 Copy Path" Click="DuplicateCopyPath_Click"/>
            <Separator/>
            <MenuItem Header="📥 Add to Collector" Click="DuplicateAddToCollector_Click"/>
        </MenuFlyout>
    </Window.Resources>

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">
        
        <!-- Header -->
        <Border Grid.Row="0" 
                Background="{DynamicResource SurfaceBrush}" 
                BorderBrush="{DynamicResource BorderBrush}" 
                BorderThickness="0,0,0,1"
                Padding="24,16">
            <Grid ColumnDefinitions="Auto,*,Auto">
                
                <!-- Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="💾" FontSize="28" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="WinTrim" FontSize="20" FontWeight="Bold" 
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Analyze and optimize your storage" FontSize="12" 
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
                
                <!-- Drive/Folder Selection -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="24,0">
                    
                    <!-- Drive Dropdown (Windows/Linux) - hidden on macOS sandbox -->
                    <ComboBox ItemsSource="{Binding AvailableDrives}" 
                              SelectedItem="{Binding SelectedDrive}"
                              Width="280" Margin="0,0,8,0"
                              VerticalContentAlignment="Center"
                              IsVisible="{Binding !UseFolderPickerMode}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="Medium" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding DriveType}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text=" - " Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding TotalSize, Converter={StaticResource FileSizeConverter}}" 
                                               Foreground="{DynamicResource AccentBrush}"/>
                                    <TextBlock Text=" (" Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding AvailableFreeSpace, Converter={StaticResource FileSizeConverter}}" 
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text=" free)" Foreground="{DynamicResource TextMutedBrush}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    
                    <!-- Folder Selection Display (macOS sandbox mode) -->
                    <Border IsVisible="{Binding UseFolderPickerMode}"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="4"
                            Padding="12,6" MinWidth="200" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📁" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SelectedFolderDisplayName, FallbackValue='Choose a folder...'}" 
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontWeight="Medium"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Express Scan Toggle (only for drive mode, not folder mode) -->
                    <CheckBox IsChecked="{Binding ExpressScanEnabled}" 
                              Content="⚡ Express" 
                              ToolTip.Tip="Express mode: Scan only your user folder (~/) for faster results. Disable for full disk scan."
                              Margin="0,0,8,0"
                              VerticalAlignment="Center"
                              IsVisible="{Binding !UseFolderPickerMode}"/>
                    
                    <Button Content="📁 Choose Folder" Command="{Binding BrowseFolderCommand}" 
                            Classes="Outline" Margin="0,0,8,0"/>
                    
                    <Button Content="🔄" Command="{Binding RefreshDrivesCommand}" 
                            Classes="Outline" ToolTip.Tip="Refresh drives" Padding="8"
                            IsVisible="{Binding !UseFolderPickerMode}"/>
                </StackPanel>
                
                <!-- Scan Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <!-- Export Menu -->
                    <Button Classes="Outline" 
                            ToolTip.Tip="Export scan results" Padding="10,8" Margin="0,0,8,0"
                            FontSize="16"
                            IsEnabled="{Binding ScanResult, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <Button.Content>
                            <TextBlock Text="📤"/>
                        </Button.Content>
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuItem Header="Export to CSV..." Command="{Binding ExportToCsvCommand}"/>
                                <MenuItem Header="Export to JSON..." Command="{Binding ExportToJsonCommand}"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    
                    <Button Content="⚙" Command="{Binding ToggleSettingsCommand}"
                            Classes="Outline" 
                            ToolTip.Tip="Settings" Padding="10,8" Margin="0,0,8,0"
                            FontSize="16"/>
                    
                    <Button Content="▶ Start Scan" Command="{Binding StartScanCommand}"
                            Classes="Primary" Margin="0,0,8,0"
                            IsEnabled="{Binding CanStart}"/>
                    <Button Command="{Binding RecallLastScanCommand}"
                            Classes="Outline" Margin="0,0,8,0"
                            IsVisible="{Binding HasCachedScan}"
                            IsEnabled="{Binding CanStart}"
                            ToolTip.Tip="{Binding CachedScanInfo}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔄" Margin="0,0,4,0"/>
                            <TextBlock Text="Recall"/>
                        </StackPanel>
                    </Button>
                    <Button Content="⏸ Pause" Command="{Binding PauseScanCommand}"
                            Classes="Outline" Margin="0,0,8,0"
                            IsVisible="{Binding CanPause}"/>
                    <Button Content="▶ Resume" Command="{Binding ResumeScanCommand}"
                            Classes="Secondary" Margin="0,0,8,0"
                            IsVisible="{Binding CanResume}"/>
                    <Button Content="⏹ Stop" Command="{Binding StopScanCommand}"
                            Classes="Danger"
                            IsVisible="{Binding CanStop}"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Progress Bar -->
        <Border Grid.Row="1" 
                Background="{DynamicResource SurfaceBrush}" 
                BorderBrush="{DynamicResource BorderBrush}" 
                BorderThickness="0,0,0,1"
                Padding="24,12" 
                IsVisible="{Binding CanStop}">
            <Grid ColumnDefinitions="*,Auto">
                
                <StackPanel Grid.Column="0">
                    <ProgressBar Value="{Binding ScanProgress.ProgressPercentage}" 
                                 Maximum="100" 
                                 Classes="ScanProgress" 
                                 Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding ScanProgress.CurrentFolder}" 
                               FontSize="12" 
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="24,0,0,0">
                    <TextBlock Text="{Binding ScanProgress.FilesScanned, StringFormat='{}{0:N0} files'}" 
                               Margin="0,0,16,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding ScanProgress.FoldersScanned, StringFormat='{}{0:N0} folders'}" 
                               Margin="0,0,16,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding ScanProgress.BytesScanned, Converter={StaticResource FileSizeConverter}}" 
                               FontWeight="Medium" Foreground="{DynamicResource PrimaryBrush}"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Main Content -->
        <TabControl x:Name="MainTabControl" Grid.Row="2" Margin="24,16">
            
            <!-- Overview Tab -->
            <TabItem Header="📊 Overview">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="0,16,0,0" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
                    
                        <!-- Category Breakdown -->
                        <Border Grid.Column="0" Grid.Row="0" Classes="Card" Margin="0,0,8,8">
                            <Grid ColumnDefinitions="Auto,*">
                                
                                <!-- Left: Pie Chart -->
                                <StackPanel Grid.Column="0" Width="220">
                                    <TextBlock Text="File Categories" Classes="SectionHeader"/>
                                    <lvc:PieChart Series="{Binding CategorySeries}" 
                                                  Height="140" Width="140"
                                                  TooltipPosition="Top"
                                                  LegendPosition="Hidden"
                                                  Margin="5,0,0,12"/>
                                    
                                    <!-- Category Legend -->
                                    <ScrollViewer MaxHeight="180">
                                        <ItemsControl ItemsSource="{Binding CategoryLegendItems}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:CategoryLegendItem">
                                                    <Button Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SelectCategoryCommand}"
                                                            CommandParameter="{Binding CategoryKey}"
                                                            HorizontalContentAlignment="Left"
                                                            Padding="4,3" Margin="0,1"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Cursor="Hand">
                                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                                            <Ellipse Grid.Column="0" Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,8,0"
                                                                     Fill="{Binding Color}"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding DisplayText}" FontSize="11"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                                       TextTrimming="CharacterEllipsis" MaxWidth="130"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding FileCountText}" FontSize="10"
                                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                                       VerticalAlignment="Center" Margin="4,0,0,0"/>
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                                
                                <!-- Right: File List -->
                                <Grid Grid.Column="1" Margin="12,0,0,0" RowDefinitions="Auto,*">
                                    
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="{Binding SelectedCategoryName, FallbackValue='Select a category'}" 
                                                   FontWeight="SemiBold" FontSize="14"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding CategoryFiles.Count, StringFormat=' ({0} files)'}" 
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   IsVisible="{Binding SelectedCategoryName, Converter={StaticResource NullToBool}}"/>
                                    </StackPanel>
                                    
                                    <DataGrid Grid.Row="1" ItemsSource="{Binding CategoryFiles}" 
                                              MaxHeight="200"
                                              CanUserSortColumns="True"
                                              CanUserResizeColumns="True"
                                              HorizontalScrollBarVisibility="Auto"
                                              DoubleTapped="DataGrid_DoubleTapped"
                                              SelectionChanged="FileItem_SelectionChanged"
                                              ContextFlyout="{StaticResource FileItemContextMenu}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" MinWidth="80" SortMemberPath="Name"/>
                                            <DataGridTextColumn Header="Size" Binding="{Binding SizeFormatted}" Width="*" MinWidth="65" SortMemberPath="Size"/>
                                            <DataGridTemplateColumn Header="Open" Width="50">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Content="📂" 
                                                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenInExplorerCommand}"
                                                                CommandParameter="{Binding}"
                                                                Classes="Outline" 
                                                                Padding="2" Cursor="Hand"
                                                                ToolTip.Tip="Open file location"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Grid>
                        </Border>
                        
                        <!-- Largest Folders -->
                        <Border Grid.Column="1" Grid.Row="0" Classes="Card" Margin="8,0,0,8">
                            <Grid ColumnDefinitions="*,*">
                                <Grid Grid.Column="0" RowDefinitions="Auto,*">
                                    <TextBlock Grid.Row="0" Text="Largest Folders" Classes="SectionHeader"/>
                                    <DataGrid Grid.Row="1" ItemsSource="{Binding LargestFolders}" 
                                              MaxHeight="260" Margin="0,8,0,0"
                                              IsReadOnly="True"
                                              CanUserSortColumns="True"
                                              CanUserResizeColumns="True"
                                              HorizontalScrollBarVisibility="Auto"
                                              HeadersVisibility="Column"
                                              GridLinesVisibility="None"
                                              Background="Transparent"
                                              DoubleTapped="DataGrid_DoubleTapped"
                                              SelectionChanged="LargestFolders_SelectionChanged"
                                              ContextFlyout="{StaticResource FileItemContextMenu}">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="Name" Width="2*" SortMemberPath="Name">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SelectFolderCommand}"
                                                                CommandParameter="{Binding}"
                                                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                                HorizontalContentAlignment="Left" Padding="4,2">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="📁" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding Name}" 
                                                                           Foreground="{DynamicResource TextPrimaryBrush}" 
                                                                           VerticalAlignment="Center"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Size" Binding="{Binding SizeFormatted}" Width="*" MinWidth="60" SortMemberPath="Size"/>
                                            <DataGridTemplateColumn Header="Open" Width="50">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Content="📂" ToolTip.Tip="Open in Explorer"
                                                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenInExplorerCommand}"
                                                                CommandParameter="{Binding}"
                                                                Background="Transparent" BorderThickness="0"
                                                                Padding="4,2" Cursor="Hand"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                                <Grid Grid.Column="1" Margin="16,0,0,0" RowDefinitions="Auto,*">
                                    <TextBlock Grid.Row="0" Text="{Binding SelectedFolderName, FallbackValue='Click a folder to see contents'}" 
                                               Classes="SectionHeader" FontSize="14"/>
                                    <DataGrid Grid.Row="1" ItemsSource="{Binding FolderContents}" 
                                              MaxHeight="200" Margin="0,8,0,0"
                                              CanUserResizeColumns="True"
                                              HorizontalScrollBarVisibility="Auto"
                                              DoubleTapped="DataGrid_DoubleTapped"
                                              SelectionChanged="FileItem_SelectionChanged"
                                              ContextFlyout="{StaticResource FileItemContextMenu}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" MinWidth="80" SortMemberPath="Name"/>
                                            <DataGridTextColumn Header="Size" Binding="{Binding SizeFormatted}" Width="*" MinWidth="60" SortMemberPath="Size"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Grid>
                        </Border>
                        
                        <!-- Games Section -->
                        <Border Grid.Column="0" Grid.Row="1" Classes="Card" Margin="0,8,8,0">
                            <StackPanel>
                                <TextBlock Text="🎮 Game Installations" Classes="SectionHeader"/>
                                <DataGrid ItemsSource="{Binding Games}" 
                                          MaxHeight="200"
                                          IsReadOnly="True"
                                          CanUserSortColumns="True"
                                          CanUserResizeColumns="True"
                                          HorizontalScrollBarVisibility="Auto"
                                          DoubleTapped="DataGrid_DoubleTapped"
                                          SelectionChanged="Game_SelectionChanged"
                                          ContextFlyout="{StaticResource GameContextMenu}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" MinWidth="100" SortMemberPath="Name"/>
                                        <DataGridTextColumn Header="Size" Binding="{Binding SizeFormatted}" Width="*" MinWidth="60" SortMemberPath="Size"/>
                                        <DataGridTextColumn Header="Last Played" Binding="{Binding LastPlayed, Converter={StaticResource RelativeTime}}" Width="*" MinWidth="70" SortMemberPath="LastPlayed"/>
                                        <DataGridTemplateColumn Header="Open" Width="50">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="📂" 
                                                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenGameFolderCommand}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip.Tip="Open in Explorer"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Padding="4,2"
                                                            Cursor="Hand"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <!-- Developer Tools Section - moved to right column -->
                        <Border Grid.Column="1" Grid.Row="1" Classes="Card" Margin="8,8,0,0">
                            <Grid RowDefinitions="Auto,Auto,*">
                                <TextBlock Grid.Row="0" Text="🛠️ Developer Tools &amp; Caches" Classes="SectionHeader"/>
                                <TextBlock Grid.Row="1" Text="Large caches from development tools that can be safely cleaned"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="11"
                                           Margin="0,0,0,8"/>
                                <DataGrid Grid.Row="2" ItemsSource="{Binding DevToolItems}" 
                                          MaxHeight="200"
                                          IsReadOnly="True"
                                          CanUserSortColumns="True"
                                          CanUserResizeColumns="True"
                                          HeadersVisibility="Column"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto"
                                          DoubleTapped="DataGrid_DoubleTapped"
                                          SelectionChanged="DevTool_SelectionChanged"
                                          ContextFlyout="{StaticResource DevToolContextMenu}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" MinWidth="80" SortMemberPath="Name"/>
                                        <DataGridTextColumn Header="Size" Binding="{Binding SizeFormatted}" Width="*" MinWidth="60" SortMemberPath="SizeBytes"/>
                                        <DataGridTextColumn Header="Last Used" Binding="{Binding LastAccessedFormatted}" Width="*" MinWidth="70"/>
                                        <DataGridTemplateColumn Header="Open" Width="50">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="📂" 
                                                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenDevToolPathCommand}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip.Tip="Open in Explorer"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Padding="4,2"
                                                            Cursor="Hand"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>
            
            <!-- Cleanup Tab - Full space for suggestions and file details -->
            <TabItem Header="🧹 Cleanup">
                <Grid Margin="0,16,0,0" RowDefinitions="Auto,*">
                    
                    <!-- Header with Quick Clean -->
                    <Border Grid.Row="0" Classes="Card" Margin="0,0,0,8" Padding="12">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="🧹 Cleanup Suggestions" Classes="SectionHeader" Margin="0"/>
                                <TextBlock Text=" - Select items to clean and free up disk space" 
                                           Foreground="{DynamicResource TextSecondaryBrush}" 
                                           VerticalAlignment="Center" Margin="16,0,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="2" 
                                    x:Name="QuickCleanButton"
                                    Click="QuickCleanButton_Click"
                                    IsVisible="{Binding HasQuickCleanItems}"
                                    Background="#4CAF50"
                                    Foreground="White"
                                    Padding="12,6"
                                    Cursor="Hand"
                                    ToolTip.Tip="Clean all safe/low-risk items with one click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚡ Quick Clean" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding QuickCleanInfo}" Margin="8,0,0,0" Opacity="0.9"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                    
                    <!-- Main Cleanup Content -->
                    <Grid Grid.Row="1" ColumnDefinitions="*,2*">
                        
                        <!-- Left: Suggestions List -->
                        <Border Grid.Column="0" Classes="Card" Margin="0,0,8,0">
                            <Grid RowDefinitions="Auto,*">
                                <TextBlock Grid.Row="0" Text="Suggestions" Classes="SectionHeader"/>
                                <DataGrid Grid.Row="1" ItemsSource="{Binding CleanupSuggestions}"
                                          SelectionChanged="CleanupSuggestions_SelectionChanged"
                                          IsReadOnly="True"
                                          CanUserSortColumns="True"
                                          CanUserResizeColumns="True"
                                          HorizontalScrollBarVisibility="Auto"
                                          DoubleTapped="DataGrid_DoubleTapped"
                                          ContextFlyout="{StaticResource CleanupSuggestionContextMenu}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" MinWidth="150" SortMemberPath="Description"/>
                                        <DataGridTextColumn Header="Size" Binding="{Binding SavingsFormatted}" Width="Auto" MinWidth="70" SortMemberPath="PotentialSavings"/>
                                        <DataGridTextColumn Header="Files" Binding="{Binding AffectedFiles.Count}" Width="Auto" MinWidth="50"/>
                                        <DataGridTextColumn Header="Risk" Binding="{Binding RiskLevel}" Width="Auto" MinWidth="55" SortMemberPath="RiskLevel"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                        
                        <!-- Right: Affected Files with Details -->
                        <Border Grid.Column="1" Classes="Card" Margin="8,0,0,0">
                            <Grid RowDefinitions="Auto,*">
                                <TextBlock Grid.Row="0" Text="{Binding SelectedCleanupDescription, FallbackValue='Select a suggestion to see affected files'}" 
                                           Classes="SectionHeader" TextTrimming="CharacterEllipsis"/>
                                <DataGrid x:Name="CleanupFilesGrid"
                                          Grid.Row="1" ItemsSource="{Binding CleanupFiles}" 
                                          Margin="0,8,0,0"
                                          CanUserSortColumns="True"
                                          CanUserResizeColumns="True"
                                          HorizontalScrollBarVisibility="Auto"
                                          SelectionChanged="CleanupFilesGrid_SelectionChanged"
                                          DoubleTapped="DataGrid_DoubleTapped"
                                          ContextFlyout="{StaticResource CleanupFileContextMenu}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="File Name" Binding="{Binding FileName}" Width="2*" MinWidth="150" SortMemberPath="FileName"/>
                                        <DataGridTextColumn Header="Size" Binding="{Binding SizeFormatted}" Width="Auto" MinWidth="70" SortMemberPath="SizeBytes"/>
                                        <DataGridTextColumn Header="Last Accessed" Binding="{Binding LastAccessedFormatted}" Width="Auto" MinWidth="100" SortMemberPath="LastAccessed"/>
                                        <DataGridTextColumn Header="Risk" Binding="{Binding Risk}" Width="Auto" MinWidth="60" SortMemberPath="Risk"/>
                                        <DataGridTextColumn Header="Full Path" Binding="{Binding FilePath}" Width="3*" MinWidth="200" SortMemberPath="FilePath"/>
                                        <DataGridTemplateColumn Header="Open" Width="50">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="📂" 
                                                            Click="CleanupFileOpenButton_Click"
                                                            Background="Transparent"
                                                            Padding="4,2"
                                                            Cursor="Hand"
                                                            HorizontalAlignment="Center"
                                                            ToolTip.Tip="Open file location"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
            
            <!-- Treemap Tab (Placeholder for now) -->
            <TabItem Header="🗺️ Treemap">
                <Grid Margin="0,16,0,0" RowDefinitions="Auto,Auto,*">
                    
                    <!-- Header -->
                    <Border Grid.Row="0" Classes="Card" Margin="0,0,0,8" Padding="12">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="🗺️ Storage Treemap" Classes="SectionHeader" Margin="0"/>
                                <TextBlock Text=" - Double-click to zoom, right-click to go back" 
                                           Foreground="{DynamicResource TextSecondaryBrush}" 
                                           VerticalAlignment="Center" Margin="16,0,0,0"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <TextBlock Text="Color by:" VerticalAlignment="Center" 
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0"/>
                                <ComboBox ItemsSource="{Binding AvailableTreemapColorModes}"
                                          SelectedItem="{Binding SelectedTreemapColorMode}"
                                          Width="100"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    
                    <!-- Legend -->
                    <Border Grid.Row="1" Classes="Card" Margin="0,0,0,8" Padding="8,6">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding TreemapLegendItems}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TreemapLegendItem">
                                        <StackPanel Orientation="Horizontal" Margin="8,0">
                                            <Border Width="14" Height="14" CornerRadius="2" Margin="0,0,6,0"
                                                    Background="{Binding Color}"/>
                                            <TextBlock Text="{Binding Label}" FontSize="11" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                    
                    <!-- Treemap Visualization -->
                    <Border Grid.Row="2" Classes="Card" Padding="4">
                        <ctrl:TreemapControl x:Name="TreemapView"
                                             SourceItem="{Binding TreemapRootItem}"
                                             MaxDepth="{Binding TreemapMaxDepth}"
                                             SelectedTheme="{Binding SelectedTheme}"
                                             ColorMode="{Binding SelectedTreemapColorMode}"/>
                    </Border>
                </Grid>
            </TabItem>
            
            <!-- File Explorer Tab -->
            <TabItem Header="📁 File Explorer">
                <Grid Margin="0,16,0,0" ColumnDefinitions="350,8,*">
                    
                    <!-- Folder Tree -->
                    <Border Grid.Column="0" Classes="Card">
                        <Grid RowDefinitions="Auto,Auto,*">
                            <TextBlock Grid.Row="0" Text="Folder Structure" Classes="SectionHeader"/>
                            
                            <!-- Search and Sort -->
                            <Grid Grid.Row="1" Margin="0,0,0,8" ColumnDefinitions="*,Auto">
                                <TextBox Grid.Column="0"
                                         Text="{Binding TreeSearchText}"
                                         Watermark="Search folders..."
                                         Margin="0,0,8,0"/>
                                
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding TreeSortOptions}"
                                          SelectedItem="{Binding TreeSortBy}"
                                          Width="90"
                                          ToolTip.Tip="Sort folders by"/>
                            </Grid>
                            
                            <TreeView Grid.Row="2" 
                                      ItemsSource="{Binding FilteredRootItems}" 
                                      SelectedItem="{Binding SelectedItem}">
                                <TreeView.ItemTemplate>
                                    <TreeDataTemplate ItemsSource="{Binding Children}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📁" Margin="0,0,6,0" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Name}" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text=" - " Foreground="{DynamicResource TextMutedBrush}"/>
                                            <TextBlock Text="{Binding SizeFormatted}" 
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding PercentageOfParent, StringFormat=' ({0:F1}%)'}" 
                                                       Foreground="{DynamicResource TextMutedBrush}"/>
                                        </StackPanel>
                                    </TreeDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </Grid>
                    </Border>
                    
                    <!-- GridSplitter -->
                    <GridSplitter Grid.Column="1" 
                                  Background="Transparent"
                                  ResizeDirection="Columns"/>
                    
                    <!-- File Details -->
                    <Border Grid.Column="2" Classes="Card">
                        <Grid RowDefinitions="Auto,Auto,*">
                            
                            <!-- Selected Item Details -->
                            <StackPanel Grid.Row="0" IsVisible="{Binding SelectedItem, Converter={StaticResource NullToBool}}">
                                <TextBlock Text="Selected Item" Classes="SectionHeader"/>
                                <Grid Margin="0,0,0,16" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto">
                                    
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Path:" Classes="DataLabel" Margin="0,0,16,4"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedItem.FullPath}" 
                                               Classes="DataValue" TextTrimming="CharacterEllipsis"/>
                                    
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Size:" Classes="DataLabel" Margin="0,0,16,4"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedItem.SizeFormatted}" 
                                               Classes="DataValue"/>
                                    
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Last Accessed:" Classes="DataLabel" Margin="0,0,16,4"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedItem.LastAccessed, Converter={StaticResource RelativeTime}}" 
                                               Classes="DataValue"/>
                                    
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Modified:" Classes="DataLabel" Margin="0,0,16,4"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedItem.LastModified, StringFormat='{}{0:g}'}" 
                                               Classes="DataValue"/>
                                </Grid>
                                
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="📂 Open in Explorer" 
                                            Command="{Binding OpenInExplorerCommand}" 
                                            CommandParameter="{Binding SelectedItem}"
                                            Classes="Outline" Margin="0,0,8,0"/>
                                    <Button Content="📋 Copy Path" 
                                            Command="{Binding CopyPathCommand}" 
                                            CommandParameter="{Binding SelectedItem}"
                                            Classes="Outline"/>
                                </StackPanel>
                            </StackPanel>
                            
                            <!-- Filter Controls -->
                            <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" 
                                    CornerRadius="4" Padding="8" Margin="0,8,0,8"
                                    IsVisible="{Binding SelectedItem, Converter={StaticResource NullToBool}}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox Grid.Column="0" 
                                             Text="{Binding FileExplorerSearchText}"
                                             Watermark="Search files..."
                                             Margin="0,0,8,0"/>
                                    
                                    <ComboBox Grid.Column="1" 
                                              ItemsSource="{Binding FileExplorerFilterOptions}"
                                              SelectedItem="{Binding FileExplorerFilter}"
                                              MinWidth="150"/>
                                </Grid>
                            </Border>
                            
                            <!-- Children List -->
                            <DataGrid Grid.Row="2" ItemsSource="{Binding FilteredChildren}" 
                                      IsReadOnly="True"
                                      CanUserSortColumns="True"
                                      CanUserResizeColumns="True"
                                      HorizontalScrollBarVisibility="Auto"
                                      SelectionChanged="FileItem_SelectionChanged"
                                      ContextFlyout="{StaticResource FileItemContextMenu}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" MinWidth="120" SortMemberPath="Name"/>
                                    <DataGridTextColumn Header="Size" Binding="{Binding SizeFormatted}" Width="Auto" MinWidth="70" SortMemberPath="Size"/>
                                    <DataGridTextColumn Header="Type" Binding="{Binding Category}" Width="Auto" MinWidth="65" SortMemberPath="Category"/>
                                    <DataGridTextColumn Header="Last Accessed" Binding="{Binding LastAccessed, Converter={StaticResource RelativeTime}}" Width="Auto" MinWidth="90" SortMemberPath="LastAccessed"/>
                                    <DataGridTemplateColumn Header="Open" Width="50">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="📂" 
                                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenInExplorerCommand}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip.Tip="Open in Explorer"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Padding="4,2"
                                                        Cursor="Hand"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
            
            <!-- Largest Files Tab -->
            <TabItem Header="📈 Largest Files">
                <Border Classes="Card" Margin="0,16,0,0">
                    <Grid RowDefinitions="Auto,*">
                        <TextBlock Grid.Row="0" Text="Top 50 Largest Files" Classes="SectionHeader"/>
                        <DataGrid Grid.Row="1" 
                                  ItemsSource="{Binding LargestFiles}" 
                                  IsReadOnly="True"
                                  CanUserSortColumns="True"
                                  CanUserResizeColumns="True"
                                  HorizontalScrollBarVisibility="Auto"
                                  DoubleTapped="DataGrid_DoubleTapped"
                                  SelectionChanged="FileItem_SelectionChanged"
                                  ContextFlyout="{StaticResource FileItemContextMenu}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" MinWidth="150" SortMemberPath="Name"/>
                                <DataGridTextColumn Header="Size" Binding="{Binding SizeFormatted}" Width="Auto" MinWidth="70" SortMemberPath="Size"/>
                                <DataGridTextColumn Header="Location" Binding="{Binding FullPath}" Width="3*" MinWidth="200" SortMemberPath="FullPath"/>
                                <DataGridTextColumn Header="Type" Binding="{Binding Category}" Width="Auto" MinWidth="65" SortMemberPath="Category"/>
                                <DataGridTextColumn Header="Last Accessed" Binding="{Binding LastAccessed, Converter={StaticResource RelativeTime}}" Width="Auto" MinWidth="90" SortMemberPath="LastAccessed"/>
                                <DataGridTemplateColumn Header="Open" Width="50">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="📂" 
                                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenInExplorerCommand}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip.Tip="Open in Explorer"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="4,2"
                                                    Cursor="Hand"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>
            
            <!-- Duplicates Tab -->
            <TabItem Header="🔁 Duplicates (Beta)">
                <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
                    <!-- Header with scan button -->
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,8,0,12">
                        <Button Grid.Column="0" Content="🔍 Scan for Duplicates" 
                                Command="{Binding ScanForDuplicatesCommand}"
                                IsEnabled="{Binding !IsDuplicateScanRunning}"
                                Classes="Primary" Padding="16,8"/>
                        
                        <!-- Status text when not scanning -->
                        <TextBlock Grid.Column="1" 
                                   Text="{Binding DuplicateScanStatus}" 
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="12" Margin="16,0,0,0"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding !IsDuplicateScanRunning}"/>
                        
                        <!-- Stats on the right -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" 
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    IsVisible="{Binding HasDuplicates}">
                            <Border Background="#2F10B981" CornerRadius="4" Padding="8,4">
                                <TextBlock Foreground="#10B981" FontSize="11">
                                    <Run Text="Total: "/>
                                    <Run Text="{Binding DuplicateWastedSpaceFormatted}" FontWeight="SemiBold"/>
                                </TextBlock>
                            </Border>
                            <Border Background="{DynamicResource AccentBrush}" CornerRadius="4" Padding="8,4"
                                    IsVisible="{Binding HasSelectedDuplicates}">
                                <TextBlock Foreground="White" FontSize="11" FontWeight="SemiBold">
                                    <Run Text="{Binding SelectedDuplicatesCount}"/>
                                    <Run Text=" selected ("/>
                                    <Run Text="{Binding SelectedDuplicatesSizeFormatted}"/>
                                    <Run Text=")"/>
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </Grid>
                    
                    <!-- Premium Progress Bar Panel (only visible when scanning) -->
                    <Border Grid.Row="1" 
                            Background="#161B22" 
                            CornerRadius="12" 
                            Padding="20,16" 
                            Margin="0,0,0,16"
                            BorderBrush="#30363D" 
                            BorderThickness="1"
                            IsVisible="{Binding IsDuplicateScanRunning}">
                        <Grid RowDefinitions="Auto,Auto,Auto">
                            <!-- Header row: Status message and percentage -->
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <!-- Animated scanning indicator -->
                                    <Border Background="#1F10B981" CornerRadius="4" Padding="6,4">
                                        <TextBlock Text="⏳" FontSize="12"/>
                                    </Border>
                                    <TextBlock Text="{Binding DuplicateScanStatus}" 
                                               Foreground="#E6EDF3"
                                               FontSize="14" FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                
                                <!-- Percentage badge -->
                                <Border Grid.Column="1" 
                                        CornerRadius="8" 
                                        Padding="12,6"
                                        Background="#1F3B82F6">
                                    <TextBlock Text="{Binding DuplicateScanProgressFormatted}" 
                                               Foreground="#3B82F6"
                                               FontSize="16" FontWeight="Bold"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                            
                            <!-- Progress bar with glow effect -->
                            <Border Grid.Row="1" 
                                    Background="#21262D" 
                                    CornerRadius="6" 
                                    Height="12"
                                    Margin="0,0,0,10">
                                <Grid>
                                    <!-- Background track -->
                                    <Border Background="#21262D" CornerRadius="6"/>
                                    
                                    <!-- Progress fill with gradient -->
                                    <Border CornerRadius="6" 
                                            HorizontalAlignment="Left"
                                            Width="{Binding DuplicateScanProgress, Converter={StaticResource PercentToWidthConverter}}">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                                                <GradientStop Color="#10B981" Offset="0"/>
                                                <GradientStop Color="#34D399" Offset="0.5"/>
                                                <GradientStop Color="#10B981" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                </Grid>
                            </Border>
                            
                            <!-- Footer row: Files processed -->
                            <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
                                <!-- Show "Scanning..." when no file count yet, otherwise show progress -->
                                <TextBlock Foreground="#8B949E" FontSize="12"
                                           IsVisible="{Binding DuplicateTotalFiles, Converter={StaticResource IsZeroConverter}}">
                                    <Run Text="Scanning files..." Foreground="#C9D1D9"/>
                                </TextBlock>
                                <TextBlock Foreground="#8B949E" FontSize="12"
                                           IsVisible="{Binding DuplicateTotalFiles, Converter={StaticResource IsNotZeroConverter}}">
                                    <Run Text="Processing: "/>
                                    <Run Text="{Binding DuplicateFilesProgressFormatted}" FontWeight="SemiBold" Foreground="#C9D1D9"/>
                                    <Run Text=" candidates"/>
                                </TextBlock>
                                
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12"
                                            IsVisible="{Binding DuplicateTotalFiles, Converter={StaticResource IsNotZeroConverter}}">
                                    <TextBlock Foreground="#8B949E" FontSize="12">
                                        <Run Text="Groups found: "/>
                                        <Run Text="{Binding TotalDuplicateCount}" Foreground="#10B981" FontWeight="SemiBold"/>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                    
                    <!-- Premium Search bar -->
                    <Border Grid.Row="2" Background="#161B22" 
                            CornerRadius="10" Padding="16,12" Margin="0,0,0,16"
                            BorderBrush="#30363D" BorderThickness="1"
                            IsVisible="{Binding HasDuplicates}">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Grid.Column="0" Background="#1F6B7280" CornerRadius="6" 
                                    Padding="8,6" Margin="0,0,12,0">
                                <TextBlock Text="🔍" FontSize="14" VerticalAlignment="Center"/>
                            </Border>
                            <TextBox Grid.Column="1" 
                                     Text="{Binding DuplicateSearchText, Mode=TwoWay}"
                                     Watermark="Search files by name or location..."
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Foreground="#E6EDF3"
                                     FontSize="14"
                                     VerticalAlignment="Center"/>
                            <Border Grid.Column="2" Background="#238636" CornerRadius="16" 
                                    Padding="12,6">
                                <TextBlock Foreground="White" FontSize="12" FontWeight="SemiBold" 
                                           VerticalAlignment="Center">
                                    <Run Text="{Binding FilteredDuplicateCount}"/>
                                    <Run Text=" files"/>
                                </TextBlock>
                            </Border>
                        </Grid>
                    </Border>
                    
                    <!-- Fast Virtualized DataGrid - Premium Styling -->
                    <DataGrid Grid.Row="3" 
                              x:Name="DuplicatesDataGrid"
                              ItemsSource="{Binding FilteredDuplicateRows}"
                              AutoGenerateColumns="False"
                              CanUserReorderColumns="False"
                              CanUserResizeColumns="True"
                              CanUserSortColumns="False"
                              IsReadOnly="False"
                              SelectionMode="Single"
                              GridLinesVisibility="None"
                              BorderThickness="0"
                              CornerRadius="12"
                              Background="#0D1117"
                              BeginningEdit="DataGrid_BeginningEdit"
                              ContextFlyout="{StaticResource DuplicateContextMenu}"
                              PointerPressed="DuplicatesDataGrid_PointerPressed">
                        
                        <DataGrid.Styles>
                            <Style Selector="DataGridRow">
                                <Setter Property="MinHeight" Value="48"/>
                            </Style>
                            <Style Selector="DataGridRow:pointerover /template/ Rectangle#BackgroundRectangle">
                                <Setter Property="Fill" Value="#1A3B82F6"/>
                            </Style>
                            <Style Selector="DataGridColumnHeader">
                                <Setter Property="Background" Value="#161B22"/>
                                <Setter Property="Foreground" Value="#8B949E"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="Padding" Value="12,10"/>
                            </Style>
                        </DataGrid.Styles>
                        
                        <DataGrid.Columns>
                            <!-- Colored group stripe -->
                            <DataGridTemplateColumn Header="" Width="6" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding IsEvenGroup, Converter={StaticResource EvenGroupToBackground}}"
                                                CornerRadius="3,0,0,3"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            
                            <!-- Group number - stylish badge -->
                            <DataGridTemplateColumn Header="" Width="50" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="#1F6B7280" CornerRadius="6" 
                                                Padding="8,4" Margin="4,6"
                                                IsVisible="{Binding IsFirstInGroup}"
                                                BoxShadow="0 1 3 0 #20000000">
                                            <TextBlock Text="{Binding GroupNumber}" 
                                                       HorizontalAlignment="Center"
                                                       FontWeight="Bold"
                                                       FontSize="13"
                                                       Foreground="#E6EDF3"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            
                            <!-- Checkbox with custom styling - Use Command instead of binding for IsReadOnly grid -->
                            <DataGridTemplateColumn Header="" Width="40">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  IsEnabled="{Binding !IsOriginal}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ToggleDuplicateRowSelectionCommand}"
                                                  CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            
                            <!-- File name with premium KEEP indicator -->
                            <DataGridTemplateColumn Header="FILE" Width="300">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="4,4">
                                            <!-- File type icon -->
                                            <Border Grid.Column="0" 
                                                    Background="{Binding IsOriginal, Converter={StaticResource OriginalFileBackground}}"
                                                    CornerRadius="6" Width="32" Height="32" 
                                                    Margin="0,0,10,0" VerticalAlignment="Center">
                                                <TextBlock Text="📄" FontSize="14" 
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            
                                            <!-- File name -->
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" 
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       FontSize="13"
                                                       Foreground="#E6EDF3"
                                                       FontWeight="{Binding IsOriginal, Converter={StaticResource BoolToFontWeight}}"/>
                                            
                                            <!-- KEEP badge with glow effect -->
                                            <Border Grid.Column="2" IsVisible="{Binding IsOriginal}" 
                                                    CornerRadius="4" Padding="8,3" Margin="8,0,0,0"
                                                    VerticalAlignment="Center">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                                        <GradientStop Color="#10B981" Offset="0"/>
                                                        <GradientStop Color="#059669" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <TextBlock Text="KEEP" FontSize="10" Foreground="White" FontWeight="Bold"/>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            
                            <!-- Directory with muted styling -->
                            <DataGridTemplateColumn Header="LOCATION" Width="*" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Directory}" 
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="#8B949E"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"
                                                   Margin="4,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            
                            <!-- Size with emphasis -->
                            <DataGridTemplateColumn Header="SIZE" Width="90" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Size, Converter={StaticResource FileSizeConverter}}" 
                                                   FontWeight="Medium"
                                                   FontSize="12"
                                                   Foreground="#E6EDF3"
                                                   VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            
                            <!-- Date with subtle styling -->
                            <DataGridTemplateColumn Header="MODIFIED" Width="95" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding LastModified, StringFormat='{}{0:MMM dd}'}"
                                                   VerticalAlignment="Center"
                                                   FontSize="11"
                                                   Foreground="#6E7681"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            
                            <!-- Match percentage - glowing badge -->
                            <DataGridTemplateColumn Header="MATCH" Width="70" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="12" Padding="10,4" 
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                BoxShadow="0 0 8 2 #3010B981">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                                    <GradientStop Color="#10B981" Offset="0"/>
                                                    <GradientStop Color="#059669" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <TextBlock Text="{Binding MatchPercent, StringFormat='{}{0}%'}"
                                                       FontSize="11" FontWeight="Bold"
                                                       Foreground="White"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            
                            <!-- Reveal button - modern icon button -->
                            <DataGridTemplateColumn Header="" Width="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RevealDuplicateInFinderCommand}"
                                                CommandParameter="{Binding}"
                                                ToolTip.Tip="Reveal in Finder"
                                                Background="#1F6B7280"
                                                BorderThickness="0"
                                                CornerRadius="6"
                                                Padding="8,6"
                                                Cursor="Hand"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="📂" FontSize="14"/>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    
                    <!-- Premium Action Bar -->
                    <Border Grid.Row="4" Padding="16" Margin="0,16,0,0" 
                            Background="#161B22" CornerRadius="12"
                            BorderBrush="#30363D" BorderThickness="1"
                            IsVisible="{Binding HasDuplicates}">
                        <Grid ColumnDefinitions="*,Auto">
                            <!-- Summary on left -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                                <TextBlock Foreground="#8B949E" FontSize="13" VerticalAlignment="Center">
                                    <Run Text="💾 Total recoverable: "/>
                                    <Run Text="{Binding DuplicateWastedSpaceFormatted}" Foreground="#10B981" FontWeight="Bold"/>
                                </TextBlock>
                                <TextBlock Foreground="#8B949E" FontSize="13" VerticalAlignment="Center"
                                           IsVisible="{Binding HasSelectedDuplicates}">
                                    <Run Text="✓ Selected: "/>
                                    <Run Text="{Binding SelectedDuplicatesCount}" Foreground="#3B82F6" FontWeight="Bold"/>
                                    <Run Text=" ("/>
                                    <Run Text="{Binding SelectedDuplicatesSizeFormatted}" Foreground="#3B82F6" FontWeight="Bold"/>
                                    <Run Text=")"/>
                                </TextBlock>
                            </StackPanel>
                            
                            <!-- Buttons on right -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                <Button Command="{Binding SelectAllDuplicatesCommand}"
                                        Background="#21262D" BorderBrush="#30363D" BorderThickness="1"
                                        CornerRadius="8" Padding="16,10" Cursor="Hand">
                                    <TextBlock Text="Select All" Foreground="#E6EDF3" FontWeight="Medium"/>
                                </Button>
                                <Button Command="{Binding DeselectAllDuplicatesCommand}"
                                        Background="#21262D" BorderBrush="#30363D" BorderThickness="1"
                                        CornerRadius="8" Padding="16,10" Cursor="Hand">
                                    <TextBlock Text="Deselect All" Foreground="#E6EDF3" FontWeight="Medium"/>
                                </Button>
                                <Button Command="{Binding AddSelectedDuplicatesToCollectorCommand}"
                                        CornerRadius="8" Padding="20,10" Cursor="Hand"
                                        BorderThickness="0">
                                    <Button.Background>
                                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                            <GradientStop Color="#10B981" Offset="0"/>
                                            <GradientStop Color="#059669" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Button.Background>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="📥" FontSize="14"/>
                                        <TextBlock Text="Add to Collector" Foreground="White" FontWeight="Bold"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
            
            <!-- Time Machine Tab (macOS only) -->
            <TabItem Header="⏰ Time Machine (Beta)" IsVisible="{Binding IsTimeMachineAvailable}">
                <Grid RowDefinitions="Auto,Auto,*">
                    <!-- Header with controls -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,8,0,16" Spacing="12">
                        <Button Content="🔄 Refresh" 
                                Command="{Binding LoadTimeMachineDestinationsCommand}"
                                Classes="Outline" Padding="12,8"/>
                        
                        <ComboBox ItemsSource="{Binding TimeMachineDestinations}"
                                  SelectedItem="{Binding SelectedTimeMachineDestination}"
                                  MinWidth="200" VerticalAlignment="Center">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="💾"/>
                                        <TextBlock Text="{Binding Name}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        
                        <Button Content="🔍 Analyze Backups" 
                                Command="{Binding AnalyzeTimeMachineCommand}"
                                IsEnabled="{Binding !IsTimeMachineScanRunning}"
                                Classes="Primary" Padding="16,8"/>
                        
                        <ProgressBar Value="{Binding TimeMachineProgress}" 
                                     Maximum="100" 
                                     Width="200" Height="8"
                                     IsVisible="{Binding IsTimeMachineScanRunning}"
                                     Classes="ScanProgress" VerticalAlignment="Center"/>
                        
                        <TextBlock Text="{Binding TimeMachineStatus}" 
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <!-- Destination Info -->
                    <Border Grid.Row="1" Classes="Card" Margin="0,0,0,16"
                            IsVisible="{Binding SelectedTimeMachineDestination, Converter={StaticResource NullToBool}}">
                        <Grid ColumnDefinitions="*,*,*">
                            <StackPanel>
                                <TextBlock Text="Backup Location" 
                                           Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                                <TextBlock Text="{Binding SelectedTimeMachineDestination.MountPath}" 
                                           Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <TextBlock Text="Snapshots" 
                                           Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                                <TextBlock Text="{Binding TimeMachineAnalysis.SnapshotCount, FallbackValue='-'}" 
                                           Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                <TextBlock Text="Used Space" 
                                           Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                                <TextBlock Text="{Binding SelectedTimeMachineDestination.UsedSpace, Converter={StaticResource SizeToString}}" 
                                           Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    
                    <!-- Analysis Results -->
                    <ScrollViewer Grid.Row="2" IsVisible="{Binding HasTimeMachineAnalysis}">
                        <StackPanel Spacing="16">
                            <!-- Suggestions Section -->
                            <StackPanel>
                                <TextBlock Text="💡 Optimization Suggestions" Classes="SectionHeader" Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding TimeMachineAnalysis.Suggestions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Classes="Card" Margin="0,0,0,8">
                                                <Grid ColumnDefinitions="*,Auto,Auto">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" 
                                                                   FontWeight="SemiBold" 
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                        <TextBlock Text="{Binding Description}" 
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   FontSize="12" TextWrapping="Wrap" MaxWidth="500"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="1" 
                                                            Background="#2F10B981" CornerRadius="4" 
                                                            Padding="8,4" Margin="8,0" VerticalAlignment="Center">
                                                        <TextBlock Foreground="#10B981" FontSize="12">
                                                            <Run Text="Save ~"/>
                                                            <Run Text="{Binding EstimatedSavings, Converter={StaticResource SizeToString}}" FontWeight="SemiBold"/>
                                                        </TextBlock>
                                                    </Border>
                                                    <Button Grid.Column="2" Content="Exclude" 
                                                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ExcludeFromTimeMachineCommand}"
                                                            CommandParameter="{Binding PathToExclude}"
                                                            IsVisible="{Binding PathToExclude, Converter={StaticResource NullToBool}}"
                                                            Classes="Outline" Padding="12,6" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            
                            <!-- Largest Folders -->
                            <StackPanel IsVisible="{Binding TimeMachineAnalysis.LargestFolders.Count}">
                                <TextBlock Text="📁 Largest Folders in Backup" Classes="SectionHeader" Margin="0,0,0,8"/>
                                <DataGrid ItemsSource="{Binding TimeMachineAnalysis.LargestFolders}"
                                          AutoGenerateColumns="False" IsReadOnly="True"
                                          GridLinesVisibility="Horizontal"
                                          MaxHeight="250">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Folder" Binding="{Binding RelativePath}" Width="2*"/>
                                        <DataGridTextColumn Header="Size" Binding="{Binding TotalSize, Converter={StaticResource SizeToString}}" Width="100"/>
                                        <DataGridTextColumn Header="Files" Binding="{Binding FileCount}" Width="80"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                    
                    <!-- Empty State -->
                    <StackPanel Grid.Row="2" 
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                IsVisible="{Binding !HasTimeMachineAnalysis}">
                        <TextBlock Text="⏰" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                        <TextBlock Text="Time Machine Analyzer" 
                                   FontSize="18" FontWeight="SemiBold" 
                                   Foreground="{DynamicResource TextPrimaryBrush}" 
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Click 'Refresh' to discover backup destinations, then 'Analyze' to find optimization opportunities." 
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" MaxWidth="400" TextAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>
                </Grid>
            </TabItem>
            
        </TabControl>
        
        <!-- Status Bar with Collector Toggle -->
        <Border Grid.Row="3" 
                Background="{DynamicResource SurfaceBrush}" 
                BorderBrush="{DynamicResource BorderBrush}" 
                BorderThickness="0,1,0,0"
                Padding="24,8">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource TextSecondaryBrush}" 
                           VerticalAlignment="Center"/>
                
                <!-- Collector Toggle Button -->
                <Button Grid.Column="1" 
                        Command="{Binding ToggleCollectorCommand}"
                        Background="Transparent" BorderThickness="0"
                        Padding="12,6" Cursor="Hand"
                        VerticalAlignment="Center" Margin="0,0,16,0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="📥" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text="Collector" Foreground="{DynamicResource TextSecondaryBrush}" 
                                   VerticalAlignment="Center"/>
                        <Border Background="#10B981"
                                CornerRadius="10" Padding="8,2" MinWidth="24"
                                IsVisible="{Binding HasCollectorItems}">
                            <TextBlock Text="{Binding CollectorItemCount}" 
                                       Foreground="White" FontSize="11" FontWeight="Bold"
                                       HorizontalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Button>
                
                <TextBlock Grid.Column="2" Text="{Binding ScanResult.Duration, StringFormat='Scan time: {0:hh\\:mm\\:ss}'}" 
                           HorizontalAlignment="Right" Foreground="{DynamicResource TextMutedBrush}"
                           VerticalAlignment="Center"
                           IsVisible="{Binding ScanResult, Converter={StaticResource NullToBool}}"/>
            </Grid>
        </Border>
        
        <!-- Collector Panel (DaisyDisk-style) -->
        <Border Grid.Row="4" 
                Background="#0D1117"
                BorderBrush="#30363D" 
                BorderThickness="0,1,0,0"
                IsVisible="{Binding IsCollectorOpen}"
                MaxHeight="280">
            <Grid RowDefinitions="Auto,*,Auto">
                <!-- Collector Header -->
                <Border Grid.Row="0" Background="#161B22" Padding="16,12">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="📥" FontSize="18" VerticalAlignment="Center"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Collector" Foreground="#E6EDF3" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Foreground="#8B949E" FontSize="11">
                                    <Run Text="Drag files here or right-click → Add to Collector"/>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                        
                        <!-- Stats -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" 
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    IsVisible="{Binding HasCollectorItems}">
                            <Border Background="#1F10B981" CornerRadius="8" Padding="12,6">
                                <TextBlock Foreground="#10B981" FontSize="13">
                                    <Run Text="{Binding CollectorItemCount}"/>
                                    <Run Text=" items"/>
                                </TextBlock>
                            </Border>
                            <Border Background="#1F3B82F6" CornerRadius="8" Padding="12,6">
                                <TextBlock Foreground="#3B82F6" FontSize="13" FontWeight="SemiBold">
                                    <Run Text="{Binding CollectorTotalSizeFormatted}"/>
                                </TextBlock>
                            </Border>
                        </StackPanel>
                        
                        <!-- Close button -->
                        <Button Grid.Column="2" 
                                Command="{Binding ToggleCollectorCommand}"
                                Background="Transparent" BorderThickness="0"
                                Padding="8" Cursor="Hand">
                            <TextBlock Text="✕" Foreground="#8B949E" FontSize="14"/>
                        </Button>
                    </Grid>
                </Border>
                
                <!-- Collector Items List -->
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding CollectorItems}" Margin="8">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#21262D" CornerRadius="8" 
                                        Padding="12,8" Margin="4"
                                        BorderBrush="#30363D" BorderThickness="1"
                                        MinWidth="180" MaxWidth="280">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <!-- Icon -->
                                        <TextBlock Grid.Column="0" Text="{Binding Icon}" 
                                                   FontSize="20" VerticalAlignment="Center"
                                                   Margin="0,0,10,0"/>
                                        
                                        <!-- Name and Size -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" 
                                                       Foreground="#E6EDF3" FontSize="12"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxWidth="160"/>
                                            <TextBlock Foreground="#8B949E" FontSize="10">
                                                <Run Text="{Binding Size, Converter={StaticResource FileSizeConverter}}"/>
                                                <Run Text=" · "/>
                                                <Run Text="{Binding Source}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        
                                        <!-- Remove Button -->
                                        <Button Grid.Column="2" 
                                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RemoveFromCollectorCommand}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent" BorderThickness="0"
                                                Padding="4" Cursor="Hand"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="✕" Foreground="#6B7280" FontSize="12"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                
                <!-- Empty State -->
                <Border Grid.Row="1" 
                        IsVisible="{Binding !HasCollectorItems}"
                        Padding="40">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="📥" FontSize="32" HorizontalAlignment="Center" Opacity="0.5"/>
                        <TextBlock Text="Right-click files → 'Add to Collector' to stage them for cleanup" 
                                   Foreground="#6B7280" FontSize="13" 
                                   HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                
                <!-- Collector Action Bar -->
                <Border Grid.Row="2" Background="#161B22" Padding="16,12">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <!-- Cleanup Folder Selector -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <TextBlock Text="📁" FontSize="14" VerticalAlignment="Center"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Cleanup Folder:" Foreground="#8B949E" FontSize="10"/>
                                <TextBlock Text="{Binding CleanupFolderName}" 
                                           Foreground="#E6EDF3" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                            <Button Command="{Binding ChooseCleanupFolderCommand}"
                                    Background="#21262D" BorderBrush="#30363D" BorderThickness="1"
                                    CornerRadius="6" Padding="10,6" Cursor="Hand">
                                <TextBlock Text="Choose..." Foreground="#E6EDF3" FontSize="11"/>
                            </Button>
                            <Button Command="{Binding RevealCleanupFolderCommand}"
                                    IsVisible="{Binding HasCleanupFolder}"
                                    Background="Transparent" BorderThickness="0"
                                    Padding="6" Cursor="Hand"
                                    ToolTip.Tip="Open cleanup folder in Finder">
                                <TextBlock Text="📂" FontSize="14"/>
                            </Button>
                        </StackPanel>
                        
                        <!-- Tip text -->
                        <TextBlock Grid.Column="1" Foreground="#6B7280" FontSize="11" 
                                   VerticalAlignment="Center" HorizontalAlignment="Center"
                                   IsVisible="{Binding HasCollectorItems}">
                            <Run Text="Files will be moved to the cleanup folder. Delete from Finder when ready."/>
                        </TextBlock>
                        
                        <!-- Action Buttons -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10"
                                    IsVisible="{Binding HasCollectorItems}">
                            <Button Command="{Binding ClearCollectorCommand}"
                                    Background="#21262D" BorderBrush="#30363D" BorderThickness="1"
                                    CornerRadius="8" Padding="16,8" Cursor="Hand">
                                <TextBlock Text="Clear All" Foreground="#E6EDF3"/>
                            </Button>
                            <Button Command="{Binding MoveToCleanupFolderCommand}"
                                    CornerRadius="8" Padding="20,10" Cursor="Hand"
                                    BorderThickness="0">
                                <Button.Background>
                                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                        <GradientStop Color="#10B981" Offset="0"/>
                                        <GradientStop Color="#059669" Offset="1"/>
                                    </LinearGradientBrush>
                                </Button.Background>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="📦" FontSize="14"/>
                                    <TextBlock Text="Move to Cleanup Folder" Foreground="White" FontWeight="Bold"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
        
        <!-- Delete Confirmation Dialog Overlay -->
        <Border Grid.RowSpan="5" Background="#80000000" 
                IsVisible="{Binding IsDeleteConfirmationOpen}">
            <Border Background="{DynamicResource SurfaceBrush}" 
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    MinWidth="380" MaxWidth="450">
                <StackPanel>
                    <TextBlock Text="🗑️ Confirm Delete" FontSize="18" FontWeight="SemiBold" 
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16"/>
                    
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" 
                               Margin="0,0,0,12">
                        <Run Text="Are you sure you want to move this item to Trash?"/>
                    </TextBlock>
                    
                    <!-- Item Details -->
                    <Border Background="{DynamicResource BackgroundBrush}" 
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="4" Padding="12" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="{Binding ItemToDelete.Name}" 
                                       FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding ItemToDelete.FullPath}" 
                                       FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                       TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                            <TextBlock FontSize="11" Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,0">
                                <Run Text="Size: "/>
                                <Run Text="{Binding ItemToDelete.Size, Converter={StaticResource SizeToString}}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    
                    <!-- Warning -->
                    <Border Background="#2FEF4444" BorderBrush="#EF4444" BorderThickness="1" 
                            CornerRadius="4" Padding="8" Margin="0,0,0,16">
                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#EF4444">
                            <Run FontWeight="SemiBold">⚠️ Note:</Run>
                            <Run> Items will be moved to Trash and can be restored from there.</Run>
                        </TextBlock>
                    </Border>
                    
                    <!-- Action Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <Button Content="Cancel" Command="{Binding CancelDeleteCommand}"
                                Classes="Outline" Padding="16,8"/>
                        <Button Content="Move to Trash" Command="{Binding ConfirmDeleteCommand}"
                                Classes="Danger" Padding="16,8"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
        
        <!-- Settings Popup Overlay -->
        <Border Grid.RowSpan="5" Background="#80000000" 
                IsVisible="{Binding IsSettingsOpen}"
                PointerPressed="SettingsOverlay_PointerPressed">
            <Border Background="{DynamicResource SurfaceBrush}" 
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="24" Margin="0,80,24,0"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    MinWidth="320" MaxWidth="400">
                <StackPanel>
                    <TextBlock Text="⚙ Settings" FontSize="18" FontWeight="SemiBold" 
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16"/>
                    
                    <!-- Theme Selection -->
                    <TextBlock Text="Theme" Foreground="{DynamicResource TextSecondaryBrush}" 
                               Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding AvailableThemes}"
                              SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                              Margin="0,0,0,16" MinWidth="200"/>
                    
                    <!-- Font Size -->
                    <TextBlock Text="Font Size" Foreground="{DynamicResource TextSecondaryBrush}" 
                               Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding AvailableFontSizes}"
                              SelectedItem="{Binding SelectedFontSize, Mode=TwoWay}"
                              Margin="0,0,0,16" MinWidth="200"/>
                    
                    <!-- Treemap Depth -->
                    <TextBlock Text="Treemap Depth" Foreground="{DynamicResource TextSecondaryBrush}" 
                               Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Slider Minimum="1" Maximum="5" 
                                Value="{Binding TreemapMaxDepth}" 
                                Width="180" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding TreemapMaxDepth}" 
                                   Foreground="{DynamicResource TextPrimaryBrush}" 
                                   Margin="12,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                    
                    <!-- Separator -->
                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,16"/>
                    
                    <!-- About Section -->
                    <TextBlock Text="About WinTrim" Foreground="{DynamicResource TextSecondaryBrush}" 
                               FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock Text="Version 1.0.0" Foreground="{DynamicResource TextMutedBrush}" 
                               FontSize="11" Margin="0,0,0,4"/>
                    <TextBlock Text="© 2026 Foxxception LLC" Foreground="{DynamicResource TextMutedBrush}" 
                               FontSize="11" Margin="0,0,0,12"/>
                    
                    <!-- Disclaimer -->
                    <Border Background="#2FF59E0B" BorderBrush="#F59E0B" BorderThickness="1" 
                            CornerRadius="4" Padding="8" Margin="0,0,0,16">
                        <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="#F59E0B" LineHeight="14">
                            <Run FontWeight="SemiBold">DISCLAIMER:</Run>
                            <Run> This software is provided "as is" without warranty. Use at your own risk. Deleted files may not be recoverable.</Run>
                        </TextBlock>
                    </Border>
                    
                    <!-- Close Button -->
                    <Button Content="Close" Command="{Binding ToggleSettingsCommand}"
                            Classes="Outline" 
                            HorizontalAlignment="Right" Padding="16,8"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
